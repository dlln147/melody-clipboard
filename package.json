{
  "name": "melody-clipboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Convert Hooktheory-style clipboard melody data into MIDI files for Ableton Live and other DAWs.",
  "license": "MIT",
  "author": "Dillon Barabasz",
  "homepage": "https://github.com/dlln147/melody-clipboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlln147/melody-clipboard.git"
  },
  "bugs": {
    "url": "https://github.com/dlln147/melody-clipboard/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-store": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
