{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melody Clipboard",
  "version": "1.0.0",
  "identifier": "com.dlln147.melodyclipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Melody Clipboard",
        "width": 640,
        "height": 600,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Dillon Barabasz",
    "category": "Music",
    "shortDescription": "Clipboard melody to MIDI",
    "longDescription": "Melody Clipboard converts Hooktheory/Hookpad-style clipboard JSON into standard MIDI files for use in your DAW.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
